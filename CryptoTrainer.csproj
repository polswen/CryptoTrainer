<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Istniejące pliki w katalogu aplikacji zawierają postępy użytkownika. -->
  <Target Name="CopyMissingSlots" AfterTargets="Build">
    <ItemGroup>
      <SlotSeed Include="$(MSBuildProjectDirectory)\Jsons\Slot*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(SlotSeed)" DestinationFolder="$(OutDir)Jsons"
          Condition="!Exists('$(OutDir)Jsons\%(SlotSeed.Filename)%(SlotSeed.Extension)')" />
  </Target>

</Project>
